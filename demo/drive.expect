#!/usr/bin/expect -f
# Records the demo tour. Keep this in step with tour.vim, its headless twin:
# each numbered section here matches one there.

set timeout 20
log_user 0

if {$argc != 6} {
  puts stderr "usage: drive.expect ASCIINEMA CAST NVIM_COMMAND FORCE NVIM SOCKET"
  exit 2
}

lassign $argv asciinema cast_file nvim_command force nvim socket

set env(TERM) xterm-256color
set env(NVIM_TEST) 1

proc wait_for {pattern} {
  expect {
    -re $pattern {}
    timeout {
      puts stderr "demo: timed out waiting for screen text: $pattern"
      exit 1
    }
    eof {
      puts stderr "demo: recording ended while waiting for screen text: $pattern"
      exit 1
    }
  }
}

proc key {keys {delay 350}} {
  send -- $keys
  after $delay
}

proc type_text {text} {
  foreach character [split $text ""] {
    send -- $character
    after 90
  }
}

proc find_row {text} {
  key "/" 150
  type_text $text
  key "\r" 400
}

proc write_listing {} {
  key ":" 150
  key "w" 150
  key "\r" 450
  after 900
}

# Show a caption without typing anything: it is set over Neovim's socket, so
# it doesn't appear in the recording's keystroke overlay. An empty text hides it.
proc caption {text} {
  global nvim socket
  set quoted "'[string map {' ''} $text]'"
  # Some builds print the reply ("true") on stderr, which exec would treat as
  # a failure; 2>@1 captures it, so only a non-zero exit status fails.
  if {[catch {exec $nvim --server $socket --remote-expr "v:lua.DemoCaption($quoted)" 2>@1} err]} {
    puts stderr "demo: could not show caption: $err"
    exit 1
  }
}

set record_args [list $asciinema rec --capture-input --window-size 100x30 \
  --title "direct.vim: edit your filesystem like a buffer" -c $nvim_command --return]
if {$force eq "1"} {
  lappend record_args --overwrite
}
lappend record_args $cast_file
eval spawn -noecho $record_args

# 1. The project listing: icons, Git status, and no ignored files.
wait_for {scratch\.txt}
after 500
caption "direct.vim: edit your filesystem like a buffer"
after 3000

# 2. Browse a project as a tree.
caption "Browse a project as a tree, with Git status"
after 1000
find_row "^lua"
key "zo"
wait_for {my-plugin/}
key "j"
key "zo"
wait_for {utils\.lua}
after 2200

# 3. Rename one file by editing its name.
caption "Rename a file by editing its name"
after 1000
find_row "utils"
key "cw" 250
type_text "strings"
key "\033" 600
write_listing
wait_for {strings\.lua}
after 1800

# 4. Rename several files with :s. 'inccommand' previews the result live.
caption "Rename many at once, with any Vim command"
after 1000
find_row "^tests"
key "zo"
wait_for {config_test\.lua}
after 900
key ":" 150
type_text "%s/_test/_spec/"
after 900
key "\r" 600
write_listing
wait_for {config_spec\.lua}
after 1800
key "zM" 800

# 5. Create a file, with its parent folders.
caption "Add a line to create a file, parent folders included"
after 1000
key "G"
key "o"
type_text "docs/guide/getting-started.md"
key "\033" 600
write_listing
wait_for {getting-started\.md}
after 2200

# 6-8. Delete a file, undo the deletion on disk, then redo it.
caption "Delete a line to delete the file"
after 1000
find_row "scratch"
key "dd" 500
write_listing
after 1300
caption "Changed your mind? u undoes it on disk"
after 1200
key "u"
wait_for {scratch\.txt}
after 1800
caption "...and Ctrl-r redoes it"
after 1000
key "\022"
after 1800

# 9. Copy a folder. Pasting next to the original asks for a new name; the
# prompt starts with the old name, so clear it with Ctrl-u first.
key "zM" 800
caption "Copy whole folders with yy and p"
after 1000
find_row "^examples"
key "zo"
wait_for {minimal/}
key "j"
key "yy" 900
key "k"
key "p"
wait_for {already exists}
after 1100
key "\025" 300
type_text "advanced"
after 400
key "\r"
wait_for {advanced/}
after 2200

# 10-11. Git: show only what changed, then stage a file.
key "zM" 800
caption "gs shows only what changed"
after 1000
key "gs"
wait_for {getting-started\.md}
after 2500
caption "ga stages a file, gr unstages it"
after 1000
find_row "README"
key "ga"
after 2200

# 12. Back to the full listing.
caption ":help direct.vim"
key "gs"
wait_for {LICENSE}
after 3500
caption ""
key "ZQ" 500

expect eof
set result [wait]
if {[lindex $result 3] != 0} {
  puts stderr "demo: asciinema recording command failed: $result"
  exit 1
}
