#!/usr/bin/expect -f
# Plays the demo tour: types its keys into a terminal and waits for the
# screen to change. With an asciinema executable it records the tour; with an
# empty one (demo.sh --check) it plays the same tour in a plain terminal.

set timeout 20
log_user 0

if {$argc != 6} {
  puts stderr "usage: drive.expect ASCIINEMA CAST NVIM_COMMAND FORCE NVIM SOCKET"
  exit 2
}

lassign $argv asciinema cast_file nvim_command force nvim socket

# The terminal fits the tallest listing (the gs view, 15 rows) and the caption
# card below it with a little room, and the widest caption and messages.
set cols 74
set rows 27

set env(TERM) xterm-256color
set env(NVIM_TEST) 1

proc wait_for {pattern} {
  expect {
    -re $pattern {}
    timeout {
      puts stderr "demo: timed out waiting for screen text: $pattern"
      exit 1
    }
    eof {
      puts stderr "demo: recording ended while waiting for screen text: $pattern"
      exit 1
    }
  }
}

proc key {keys {delay 350}} {
  send -- $keys
  after $delay
}

proc type_text {text} {
  foreach character [split $text ""] {
    send -- $character
    after 90
  }
}

proc find_row {text} {
  key "/" 150
  type_text $text
  key "\r" 400
}

proc write_listing {} {
  key ":" 150
  key "w" 150
  key "\r" 450
  after 450
}

# Show a caption without typing anything: it is set over Neovim's socket, so
# it doesn't appear in the recording's keystroke overlay. The caption shows a
# title and, under it, the keys the scene uses (separated by two spaces). An
# empty title hides it.
proc caption {title {keys ""}} {
  global nvim socket
  set args "[vim_string $title], [vim_string $keys]"
  # Some builds print the reply ("true") on stderr, which exec would treat as
  # a failure; 2>@1 captures it, so only a non-zero exit status fails.
  if {[catch {exec $nvim --server $socket --remote-expr "v:lua.DemoCaption($args)" 2>@1} err]} {
    puts stderr "demo: could not show caption: $err"
    exit 1
  }
}

# Reveal the caption's next key cap. Call it just before typing that key, so
# the cap appears as the key is pressed.
proc typed {} {
  global nvim socket
  if {[catch {exec $nvim --server $socket --remote-expr "v:lua.DemoKey()" 2>@1} err]} {
    puts stderr "demo: could not show key: $err"
    exit 1
  }
}

proc vim_string {text} {
  return "'[string map {' ''} $text]'"
}

if {$asciinema eq ""} {
  # No recording: run Neovim in a terminal the size of the recording's.
  spawn -noecho sh -c "stty rows $rows cols $cols; exec $nvim_command"
} else {
  set record_args [list $asciinema rec --capture-input --window-size ${cols}x${rows} \
    --title "direct.vim: edit your filesystem like a buffer" -c $nvim_command --return]
  if {$force eq "1"} {
    lappend record_args --overwrite
  }
  lappend record_args $cast_file
  spawn -noecho {*}$record_args
}

# Searches type just enough of a name to match one line of the listing as it
# is at that point (with 'ignorecase', so "l" would also match LICENSE).

# 1. Rename: edit a name and save.
wait_for {scratch\.txt}
after 400
caption "Rename a file by editing its name" "/sc  cw  Esc  :w"
after 600
typed
find_row "sc"
typed
key "cw" 250
type_text "notes"
typed
key "\033" 600
typed
write_listing
wait_for {notes\.txt}
after 800

# 2. Create: add a line; missing parent folders are created too.
caption "Add a line to create a file, folders included" "G  o  Esc  :w"
after 600
typed
key "G"
typed
key "o"
type_text "docs/guide/getting-started.md"
typed
key "\033" 600
typed
write_listing
wait_for {getting-started\.md}
after 1000

# 3. Delete: remove the line. Then undo and redo it, on disk.
caption "Delete a line to delete the file" "/not  dd  :w"
after 600
typed
find_row "not"
typed
key "dd" 500
typed
write_listing
after 600
caption "Undo and redo work on the filesystem" "u  Ctrl-r"
after 600
typed
key "u"
wait_for {notes\.txt}
after 800
typed
key "\022"
after 900
key "zM" 800

# 4. Browse into the tree and rename a file inside it.
caption "Expand folders in place, and edit inside them" "/lua  zo  j  zo  /ut  cw  Esc  :w"
after 600
typed
find_row "lua"
typed
key "zo"
wait_for {my-plugin/}
typed
key "j"
typed
key "zo"
wait_for {utils\.lua}
after 400
typed
find_row "ut"
typed
key "cw" 250
type_text "strings"
typed
key "\033" 600
typed
write_listing
wait_for {strings\.lua}
after 800

# Collapse lua/ again, so the listing stays short enough for the terminal.
key "zM" 800

# 5. Rename several files with :s. 'inccommand' previews the result live.
caption "Rename many at once, with any Vim command" "/te  zo  :%s/_test/_spec/  :w"
after 600
typed
find_row "te"
typed
key "zo"
wait_for {config_test\.lua}
after 400
typed
key ":" 150
type_text "%s/_test/_spec/"
after 400
key "\r" 600
typed
write_listing
wait_for {config_spec\.lua}
after 900
key "zM" 800

# 6. Copy a folder. Pasting next to the original asks for a new name; the
# prompt starts with the old name, so clear it with Ctrl-u first.
caption "Copy whole folders" "/ex  zo  j  yy  k  p  Ctrl-u"
after 600
typed
find_row "ex"
typed
key "zo"
wait_for {minimal/}
typed
key "j"
typed
key "yy" 900
typed
key "k"
typed
key "p"
wait_for {already exists}
after 600
typed
key "\025" 300
type_text "advanced"
after 400
key "\r"
wait_for {advanced/}
after 1000

# 7. Git: show only what changed, then stage a file.
key "zM" 800
caption "See what changed, and stage it" "gs  /re  ga"
after 600
typed
key "gs"
wait_for {getting-started\.md}
after 1100
typed
find_row "re"
typed
key "ga"
after 1100

# 8. Back to the full listing.
key "gs"
wait_for {LICENSE}
caption "direct.vim: edit your filesystem like a buffer" ":help direct.vim"
typed
after 2500
caption ""
key "ZQ" 500

expect eof
set result [wait]
if {[lindex $result 3] != 0} {
  puts stderr "demo: the tour ended with an error: $result"
  exit 1
}
