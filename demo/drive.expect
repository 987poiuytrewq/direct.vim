#!/usr/bin/expect -f
# Plays the demo tour: types its keys into a terminal and waits for the
# screen to change. With an asciinema executable it records the tour; with an
# empty one (demo.sh --check) it plays the same tour in a plain terminal.

set timeout 20
log_user 0

if {$argc != 6} {
  puts stderr "usage: drive.expect ASCIINEMA CAST NVIM_COMMAND FORCE NVIM SOCKET"
  exit 2
}

lassign $argv asciinema cast_file nvim_command force nvim socket

# The terminal fits the tallest listing (the gs view, 15 rows) and the caption
# card below it with a little room, and the widest caption and messages.
set cols 74
set rows 27

set env(TERM) xterm-256color
set env(NVIM_TEST) 1

proc wait_for {pattern} {
  expect {
    -re $pattern {}
    timeout {
      puts stderr "demo: timed out waiting for screen text: $pattern"
      exit 1
    }
    eof {
      puts stderr "demo: recording ended while waiting for screen text: $pattern"
      exit 1
    }
  }
}

proc wait_for_sync {} {
  global nvim socket
  after 200
  for {set attempt 0} {$attempt < 200} {incr attempt} {
    set pending [exec $nvim --server $socket --remote-expr \
      {luaeval("require('direct.pending').is_pending() and 1 or 0")} 2>@1]
    if {[string trim $pending] eq "0"} { return }
    after 100
  }
  puts stderr "demo: timed out waiting for the filesystem operation to finish"
  exit 1
}

proc wait_for_file {path should_exist} {
  for {set attempt 0} {$attempt < 200} {incr attempt} {
    if {[file exists $path] == $should_exist} { return }
    after 100
  }
  puts stderr "demo: timed out waiting for file state: $path"
  exit 1
}

proc wait_for_listing_write {} {
  global nvim socket
  for {set attempt 0} {$attempt < 200} {incr attempt} {
    set modified [exec $nvim --server $socket --remote-expr {&modified} 2>@1]
    if {[string trim $modified] eq "0"} { return }
    after 100
  }
  puts stderr "demo: timed out waiting for the listing write to finish"
  exit 1
}

proc wait_for_listing_modified {} {
  global nvim socket
  for {set attempt 0} {$attempt < 200} {incr attempt} {
    set modified [exec $nvim --server $socket --remote-expr {&modified} 2>@1]
    if {[string trim $modified] eq "1"} { return }
    after 100
  }
  puts stderr "demo: timed out waiting for the listing edit: [exec $nvim --server $socket --remote-expr {string([mode(), line('.'), getline('.'), &modified])} 2>@1]"
  exit 1
}

proc key {keys {delay 350}} {
  send_input $keys
  after $delay
}

proc send_input {keys} {
  global asciinema nvim socket
  if {$asciinema eq ""} {
    exec $nvim --server $socket --remote-send $keys 2>@1
  } else {
    send -- $keys
  }
}

proc type_text {text} {
  foreach character [split $text ""] {
    send_input $character
    after 90
  }
}

proc find_row {text} {
  global nvim socket
  key "/" 150
  type_text $text
  key "\r" 400
  for {set attempt 0} {$attempt < 200} {incr attempt} {
    set line [exec $nvim --server $socket --remote-expr {getline('.')} 2>@1]
    if {[string first [string tolower $text] [string tolower $line]] >= 0} { return }
    after 100
  }
  puts stderr "demo: timed out searching for listing row: $text"
  exit 1
}

proc write_listing {} {
  global nvim socket
  wait_for_listing_modified
  key ":" 150
  key "w" 150
  key "\r" 450
  wait_for_listing_write
}

# Show a caption without typing anything: it is set over Neovim's socket, so
# it doesn't appear in the recording's keystroke overlay. The caption shows a
# title and, under it, the keys the scene uses (separated by two spaces). An
# empty title hides it.
proc caption {title {keys ""} {show_all 0}} {
  global nvim socket
  set all [expr {$show_all ? "v:true" : "v:false"}]
  set args "[vim_string $title], [vim_string $keys], $all"
  # Some builds print the reply ("true") on stderr, which exec would treat as
  # a failure; 2>@1 captures it, so only a non-zero exit status fails.
  if {[catch {exec $nvim --server $socket --remote-expr "v:lua.DemoCaption($args)" 2>@1} err]} {
    puts stderr "demo: could not show caption: $err"
    exit 1
  }
}

proc vim_string {text} {
  return "'[string map {' ''} $text]'"
}

if {$asciinema eq ""} {
  # No recording: run Neovim in a terminal the size of the recording's.
  spawn -noecho sh -c "stty rows $rows cols $cols; exec $nvim_command"
} else {
  set record_args [list $asciinema rec --capture-input --window-size ${cols}x${rows} \
    --title "direct.vim: edit your filesystem like a buffer" -c $nvim_command --return]
  if {$force eq "1"} {
    lappend record_args --overwrite
  }
  lappend record_args $cast_file
  spawn -noecho {*}$record_args
}

# Searches type just enough of a name to match one line of the listing as it
# is at that point (with 'ignorecase', so "l" would also match LICENSE).

# 1. Rename: edit a name and save.
wait_for {scratch\.txt}
after 300
caption "Rename a file by editing its name" "/sc  cw  Esc  :w"
after 400
find_row "sc"
key "cw" 250
type_text "notes"
key "\033" 600
write_listing
wait_for {notes\.txt}
after 600

# 2. Create: add a line; missing parent folders are created too. The cursor
# is still on notes.txt, the last row, so o adds the new line at the end.
caption "Add a line to create a file, folders included" "o  Esc  :w"
after 400
key "o"
type_text "docs/guide/getting-started.md"
key "\033" 600
write_listing
wait_for {getting-started\.md}
after 800

# 3. Delete: remove the line. Then undo and redo it, on disk.
caption "Delete a line to delete the file" "/not  dd  :w"
after 400
find_row "not"
key "dd" 500
write_listing
after 400
caption "Undo and redo work on the filesystem" "u  Ctrl-r"
after 400
key "u"
wait_for_file notes.txt 1
wait_for {notes\.txt}
wait_for_sync
after 600
key "\022"
wait_for_file notes.txt 0
wait_for_sync
after 700
key "zM" 800

# 4. Open a file and a folder, going back up with - each time. ("/re" would
# also match .gitignore, so search for "rea".)
caption "Open files and folders, and go back with -" "/rea  Enter  -  /docs  Enter  -"
after 400
find_row "rea"
key "\r"
wait_for {small, fast Neovim plugin}
after 900
key "-"
wait_for {LICENSE}
after 400
find_row "docs"
key "\r"
wait_for {guide/}
after 900
key "-"
wait_for {LICENSE}
after 600

# 5. Browse into the tree and rename a file inside it. zO opens lua/ and
# everything under it.
caption "Expand folders in place, and edit inside them" "/lua  zO  /ut  cw  Esc  :w"
after 400
find_row "lua"
key "zO"
wait_for {utils\.lua}
after 300
find_row "ut"
key "cw" 250
type_text "strings"
key "\033" 600
write_listing
wait_for {strings\.lua}
after 600

# Collapse lua/ again, so the listing stays short enough for the terminal.
key "zM" 800

# 6. Rename several files with :s. 'inccommand' previews the result live.
caption "Rename many at once, with any Vim command" "/te  zo  :%s/_test/_spec/  :w"
after 400
find_row "te"
key "zo"
wait_for {config_test\.lua}
after 300
key ":" 150
type_text "%s/_test/_spec/"
after 300
key "\r" 600
write_listing
wait_for {config_spec\.lua}
after 700
key "zM" 800

# 7. Copy a folder. Pasting next to the original asks for a new name; the
# prompt starts with the old name, so clear it with Ctrl-u first.
caption "Copy whole folders" "/ex  zo  j  yy  k  p  Ctrl-u"
after 400
find_row "ex"
key "zo"
wait_for {minimal/}
key "j"
key "yy" 900
key "k"
key "p"
wait_for {already exists}
after 400
key "\025" 300
type_text "advanced"
after 300
key "\r"
wait_for_file examples/advanced/init.lua 1
wait_for {advanced/}
wait_for_sync
after 800

# 8. Git: show only what changed, then stage a file.
key "zM" 800
caption "See what changed, and stage it" "gs  /re  ga"
after 400
key "gs"
wait_for {getting-started\.md}
after 800
find_row "re"
key "ga"
after 800

# 9. Back to the full listing.
key "gs"
wait_for {LICENSE}
caption "direct.vim: edit your filesystem like a buffer" ":help direct.vim" 1
after 2000
caption ""
key "ZQ" 500

expect eof
set result [wait]
if {[lindex $result 3] != 0} {
  puts stderr "demo: the tour ended with an error: $result"
  exit 1
}
